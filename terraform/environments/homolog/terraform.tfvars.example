# Região da AWS
aws_region = "sa-east-1"

# Rede: por padrão lida do SSM publicado pelo fiap-officine-kubernets
# (/fiap-officine/homolog/rds/db-subnet-group-name e .../rds/security-group-id).
# Descomente só para sobrescrever:
# db_subnet_group_name  = "fiap-officine-homolog"
# rds_security_group_id = "sg-0123456789abcdef0"

# Configurações do Banco
database_name   = "officine_db"
master_username = "dbadmin"
instance_class  = "db.t4g.micro"
